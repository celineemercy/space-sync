{
  "expo": {
    "name": "CampusSpace",
    "slug": "campus-space",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/campus-space-icon.png",
    "scheme": "campusspace",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.celineemercy.campusspace",
      "adaptiveIcon": {
        "backgroundColor": "#062D64",
        "foregroundImage": "./assets/images/campus-space-icon.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#062D64",
          "image": "./assets/images/campus-space-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}

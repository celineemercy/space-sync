API_DOMAIN=api.campusspace.example.com
TLS_EMAIL=admin@example.com

POSTGRES_DB=campus_space
POSTGRES_USER=campus_space
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://campus_space:URL_ENCODED_PASSWORD@db:5432/campus_space?schema=public

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_EXPIRES_IN=1h
CAMPUS_TIMEZONE=Asia/Jakarta
CORS_ORIGIN=https://campusspace.example.com

SEED_DEMO_EMAIL=student@example.test
SEED_DEMO_PASSWORD=replace-with-a-unique-demo-password
BACKUP_RETENTION_DAYS=14
